:root {
  --bg-color: #0f172a; /* Deep Slate Charcoal */
  --text-color: #f1f5f9; /* Crisp clean slate-white */
  --text-muted: #94a3b8; /* Steel gray muted text */
  --primary-accent: #38bdf8; /* Soft Sky Cyan (Calm & Less Bright) */
  --secondary-accent: #6366f1; /* Muted Indigo */
  
  --glass-bg: rgba(30, 41, 59, 0.7); /* Translucent slate-glass */
  --glass-border: rgba(255, 255, 255, 0.08); /* Fine steel border */
  --glass-shadow: 0 10px 30px rgba(0, 0, 0, 0.3); /* Understated dark shadow */
  
  --font-main: var(--font-inter), sans-serif;
}
